# VAULTCORE environment variables
# Copy to .env and fill in secrets. Never commit .env.

# Required: at least 32 characters, not a default value
SECRET_KEY=change-this-to-a-random-32-char-plus-secret-key-for-dev
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=postgresql+psycopg2://postgres@localhost:5432/vaultcore

# CORS (comma-separated, no wildcard when credentials enabled)
CORS_ORIGINS=http://localhost:5173

# Low-stock alert threshold
VAULTCORE_LOW_STOCK_THRESHOLD=5
